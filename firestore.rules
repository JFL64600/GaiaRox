rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{roomId} {
      allow get, delete: if roomId.size() >= 6 && roomId.size() <= 64;
      allow list: if true;
      allow write: if roomId.size() >= 6 && roomId.size() <= 64
        && request.resource.data.keys().hasOnly(['chronometers', 'name'])
        && request.resource.data.chronometers is list
        && request.resource.data.chronometers.size() <= 100
        && (!('name' in request.resource.data) || request.resource.data.name == null
            || (request.resource.data.name is string && request.resource.data.name.size() <= 40));
    }

    // Throwaway docs used to measure the offset between a device clock and the server clock.
    match /clock/{id} {
      allow create, read, delete: if id.size() >= 6 && id.size() <= 64;
    }
  }
}
